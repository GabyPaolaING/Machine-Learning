        "from scipy.stats import ttest_1samp\n",
        "\n",
        "# PASO 5: PRUEBA DE HIPÓTESIS\n",
        "\n",
        "umbral = 80.0\n",
        "alpha = 0.05\n",
        "\n",
        "# Prueba t de una muestra\n",
        "estadistico_t, p_valor_dos_colas = ttest_1samp(\n",
        "    peso,\n",
        "    umbral\n",
        ")\n",
        "\n",
        "# Convertir a prueba unilateral izquierda\n",
        "if estadistico_t < 0:\n",
        "    p_valor = p_valor_dos_colas / 2\n",
        "else:\n",
        "    p_valor = 1 - (p_valor_dos_colas / 2)\n",
        "\n",
        "print(\"PASO 5: PRUEBA DE HIPÓTESIS\")\n",
        "print(\"------------------------------\")\n",
        "print(\"H0: A = 80 kg\")\n",
        "print(\"H1: A < 80 kg\")\n",
        "print(\"Nivel de significancia:\", alpha)\n",
        "print(\"Estadístico t:\", round(estadistico_t, 4))\n",
        "print(\"p-valor unilateral:\", round(p_valor, 6))\n",
        "\n",
        "if p_valor < alpha:\n",
        "    print(\"Se rechaza H0.\")\n",
        "else:\n",
        "    print(\"No se rechaza H0.\")"
