    {
      "cell_type": "code",
      "source": [
        "# PASO 7: REGRESIÓN LINEAL\n",
        "\n",
        "from scipy.stats import linregress\n",
        "\n",
        "# Variable independiente: días\n",
        "x = df_peso['Dias']\n",
        "\n",
        "# Variable dependiente: peso\n",
        "y = df_peso['Peso(Kg)']\n",
        "\n",
        "# Crear la regresión lineal\n",
        "regresion = linregress(x, y)\n",
        "\n",
        "# Obtener los resultados\n",
        "pendiente = regresion.slope\n",
        "intercepto = regresion.intercept\n",
        "r = regresion.rvalue\n",
        "\n",
        "# Coeficiente de determinación\n",
        "r_cuadrada = r ** 2\n",
        "\n",
        "print(\"PASO 7: REGRESIÓN LINEAL\")\n",
        "print(\"------------------------------\")\n",
        "print(\"Pendiente:\", round(pendiente, 6))\n",
        "print(\"Intercepto:\", round(intercepto, 4))\n",
        "print(\"R²:\", round(r_cuadrada, 4))\n",
        "\n",
