        "# CELDA 7. Comparación de modelos OLS, Ridge y Lasso\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "from sklearn.linear_model import LinearRegression, RidgeCV, LassoCV\n",
        "from sklearn.pipeline import make_pipeline\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.model_selection import TimeSeriesSplit\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
        "\n",
        "# 1. Usar únicamente el tiempo como variable predictora\n",
        "X_comparacion = datos[[\"Dias_Transcurridos\"]].copy()\n",
        "y_comparacion = datos[\"Peso(Kg)\"].copy()\n",
        "\n",
        "# 2. Dividir los datos respetando el orden temporal\n",
        "punto_corte = int(len(datos) * 0.8)\n",
        "\n",
        "X_train = X_comparacion.iloc[:punto_corte]\n",
        "X_test = X_comparacion.iloc[punto_corte:]\n",
        "y_train = y_comparacion.iloc[:punto_corte]\n",
        "y_test = y_comparacion.iloc[punto_corte:]\n",
        "\n",
        "# 3. Crear los modelos\n",
        "modelo_ols_comp = LinearRegression()\n",
        "\n",
        "n_splits = min(5, len(X_train) - 1)\n",
        "cv = TimeSeriesSplit(n_splits=n_splits)\n",
        "\n",
        "modelo_ridge = make_pipeline(\n",
        "    StandardScaler(),\n",
        "    RidgeCV(alphas=[0.01, 0.1, 1, 10, 100], cv=cv)\n",
        ")\n",
        "\n",
        "modelo_lasso = make_pipeline(\n",
        "    StandardScaler(),\n",
        "    LassoCV(\n",
        "        alphas=[0.001, 0.01, 0.1, 1, 10],\n",
        "        cv=cv,\n",
        "        max_iter=10000\n",
        "    )\n",
        ")\n",
        "\n",
        "# 4. Entrenar los modelos\n",
        "modelo_ols_comp.fit(X_train, y_train)\n",
        "modelo_ridge.fit(X_train, y_train)\n",
        "modelo_lasso.fit(X_train, y_train)\n",
        "\n",
        "# 5. Obtener predicciones\n",
        "pred_ols = modelo_ols_comp.predict(X_test)\n",
        "pred_ridge = modelo_ridge.predict(X_test)\n",
        "pred_lasso = modelo_lasso.predict(X_test)\n",
        "\n",
        "# 6. Comparar las métricas\n",
        "resultados_modelos = []\n",
        "\n",
        "for nombre, prediccion in [\n",
        "    (\"OLS\", pred_ols),\n",
        "    (\"Ridge\", pred_ridge),\n",
        "    (\"Lasso\", pred_lasso)\n",
        "]:\n",
        "    resultados_modelos.append({\n",
        "        \"Modelo\": nombre,\n",
        "        \"MAE (kg)\": mean_absolute_error(y_test, prediccion),\n",
        "        \"RMSE (kg)\": np.sqrt(mean_squared_error(y_test, prediccion)),\n",
        "        \"R²\": r2_score(y_test, prediccion)\n",
        "    })\n",
        "\n",
        "tabla_comparacion = pd.DataFrame(resultados_modelos)\n",
        "\n",
        "print(\"COMPARACIÓN DE MODELOS\")\n",
        "print(tabla_comparacion.round(4).to_string(index=False))\n"
