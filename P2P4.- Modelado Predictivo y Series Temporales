        "# CELDA 5. Regresión lineal OLS usando el tiempo\n",
        "\n",
        "import statsmodels.api as sm\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
        "import numpy as np\n",
        "\n",
        "# Variable independiente: días transcurridos\n",
        "X_tiempo = datos[[\"Dias_Transcurridos\"]]\n",
        "\n",
        "# Variable dependiente: peso real\n",
        "y = datos[\"Peso(Kg)\"]\n",
        "\n",
        "# Agregar constante\n",
        "X_tiempo_ols = sm.add_constant(X_tiempo)\n",
        "\n",
        "# Ajustar el modelo\n",
        "modelo_ols = sm.OLS(y, X_tiempo_ols).fit()\n",
        "\n",
        "# Mostrar resultados\n",
        "print(modelo_ols.summary())\n",
        "\n",
        "# Calcular predicciones\n",
        "y_pred = modelo_ols.predict(X_tiempo_ols)\n",
        "\n",
        "# Evaluar el ajuste\n",
        "mae = mean_absolute_error(y, y_pred)\n",
        "rmse = np.sqrt(mean_squared_error(y, y_pred))\n",
        "\n",
        "print(\"\\nMÉTRICAS DEL MODELO OLS\")\n",
        "print(f\"MAE: {mae:.3f} kg\")\n",
        "print(f\"RMSE: {rmse:.3f} kg\")\n",
        "print(f\"R²: {modelo_ols.rsquared:.4f}\")\n",
        "\n",
        "print(\"\\nCOEFICIENTES\")\n",
        "print(modelo_ols.params)"
