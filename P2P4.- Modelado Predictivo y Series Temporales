        "from sklearn.model_selection import TimeSeriesSplit\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
        "\n",
        "# Cargar archivo Excel\n",
        "df_peso = pd.read_excel(\"Datos.xlsx\", header=3)\n",
        "\n",
        "df_peso.columns = df_peso.columns.astype(str).str.strip()\n",
        "\n",
        "# Convertir las fechas al año 2026\n",
        "def convertir_fecha(fecha):\n",
        "    if pd.isna(fecha):\n",
        "        return pd.NaT\n",
        "\n",
        "    if isinstance(fecha, (pd.Timestamp, np.datetime64)):\n",
        "        fecha = pd.Timestamp(fecha)\n",
        "        return pd.Timestamp(2026, fecha.month, fecha.day)\n",
        "\n",
        "    try:\n",
        "        fecha_dt = pd.to_datetime(str(fecha).strip(), format=\"%m-%d\")\n",
        "        return pd.Timestamp(2026, fecha_dt.month, fecha_dt.day)\n",
        "    except:\n",
        "        return pd.to_datetime(fecha, errors=\"coerce\")\n",
        "\n",
        "df_peso[\"Fecha_DT\"] = df_peso[\"Fecha\"].apply(convertir_fecha)\n",
        "\n",
        "df_peso[\"Peso(Kg)\"] = pd.to_numeric(\n",
        "    df_peso[\"Peso(Kg)\"], errors=\"coerce\"\n",
