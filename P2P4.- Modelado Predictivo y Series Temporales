        "\n",
        "# CELDA 4. Integrar los datos y preparar el modelo predictivo\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "# 1. Preparar las fechas y los datos de entrenamiento\n",
        "df_entrenamiento[\"fecha\"] = pd.to_datetime(\n",
        "    df_entrenamiento[\"fecha\"], errors=\"coerce\"\n",
        ")\n",
        "\n",
        "df_entrenamiento[\"Km_MTB\"] = pd.to_numeric(\n",
        "    df_entrenamiento[\"Km_MTB\"], errors=\"coerce\"\n",
        ").fillna(0)\n",
        "\n",
        "df_entrenamiento[\"Kcal_Fuerza\"] = pd.to_numeric(\n",
        "    df_entrenamiento[\"Kcal_Fuerza\"], errors=\"coerce\"\n",
        ").fillna(0)\n",
        "\n",
        "# 2. Sumar los kilómetros y las calorías por fecha\n",
        "actividad_diaria = (\n",
        "    df_entrenamiento.groupby(\"fecha\")\n",
        "    .agg(\n",
        "        Km_MTB=(\"Km_MTB\", \"sum\"),\n",
        "        Kcal_Fuerza=(\"Kcal_Fuerza\", \"sum\")\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "# 3. Preparar las mediciones reales de peso\n",
        "datos = df_peso[[\"Fecha_DT\", \"Peso(Kg)\"]].copy()\n",
        "\n",
        "datos[\"Fecha_DT\"] = pd.to_datetime(\n",
        "    datos[\"Fecha_DT\"], errors=\"coerce\"\n",
        ")\n",
        "\n",
        "datos[\"Peso(Kg)\"] = pd.to_numeric(\n",
        "    datos[\"Peso(Kg)\"], errors=\"coerce\"\n",
        ")\n",
        "\n",
        "datos = datos.dropna(subset=[\"Fecha_DT\", \"Peso(Kg)\"])\n",
        "\n",
        "# 4. Unir los entrenamientos con las fechas de peso\n",
        "datos = datos.merge(\n",
        "    actividad_diaria,\n",
        "    left_on=\"Fecha_DT\",\n",
        "    right_on=\"fecha\",\n",
        "    how=\"left\"\n",
        ")\n",
        "\n",
        "# Los ceros indican que no hay entrenamiento registrado\n",
        "# para esa fecha exacta\n",
        "datos[\"Km_MTB\"] = datos[\"Km_MTB\"].fillna(0)\n",
        "datos[\"Kcal_Fuerza\"] = datos[\"Kcal_Fuerza\"].fillna(0)\n",
        "\n",
        "# 5. Calcular los días transcurridos desde la primera medición\n",
        "datos[\"Dias_Transcurridos\"] = (\n",
        "    datos[\"Fecha_DT\"] - datos[\"Fecha_DT\"].min()\n",
        ").dt.days\n",
        "\n",
        "# 6. Crear la carga semanal de kilómetros\n",
        "# Se calcula a partir de las sesiones registradas en los últimos 7 días\n",
        "calendario = pd.DataFrame({\n",
        "    \"Fecha_DT\": pd.date_range(\n",
        "        start=datos[\"Fecha_DT\"].min(),\n",
        "        end=datos[\"Fecha_DT\"].max(),\n",
        "        freq=\"D\"\n",
        "    )\n",
        "})\n",
        "\n",
        "actividad_calendario = calendario.merge(\n",
        "    actividad_diaria,\n",
        "    left_on=\"Fecha_DT\",\n",
        "    right_on=\"fecha\",\n",
        "    how=\"left\"\n",
        ")\n",
        "\n",
        "actividad_calendario[\"Km_MTB\"] = (\n",
        "    actividad_calendario[\"Km_MTB\"].fillna(0)\n",
        ")\n",
        "\n",
        "actividad_calendario[\"Kcal_Fuerza\"] = (\n",
        "    actividad_calendario[\"Kcal_Fuerza\"].fillna(0)\n",
        ")\n",
        "\n",
        "actividad_calendario[\"Carga_Semanal_Km\"] = (\n",
        "    actividad_calendario[\"Km_MTB\"]\n",
        "    .rolling(window=7, min_periods=1)\n",
        "    .sum()\n",
        ")\n",
        "\n",
        "# 7. Incorporar la carga semanal a las mediciones de peso\n",
        "datos = datos.drop(\n",
        "    columns=[\"Carga_Semanal_Km\"], errors=\"ignore\"\n",
        ")\n",
        "\n",
        "datos = datos.merge(\n",
        "    actividad_calendario[[\"Fecha_DT\", \"Carga_Semanal_Km\"]],\n",
        "    on=\"Fecha_DT\",\n",
        "    how=\"left\"\n",
        ")\n",
        "\n",
        "# 8. Preparar las variables independientes y dependiente\n",
        "X = datos[[\n",
        "    \"Dias_Transcurridos\",\n",
        "    \"Carga_Semanal_Km\",\n",
        "    \"Kcal_Fuerza\"\n",
        "]].copy()\n",
        "\n",
        "y = datos[\"Peso(Kg)\"].copy()\n",
        "\n",
        "# Agregar constante para el modelo OLS\n",
        "import statsmodels.api as sm\n",
        "\n",
        "X_ols = sm.add_constant(X, has_constant=\"add\")\n",
        "\n",
        "# 9. Mostrar resultados para verificar\n",
        "print(\"Dimensiones de los datos:\", datos.shape)\n",
        "print(\"Mediciones de peso:\", len(datos))\n",
        "print(\"Días con kilómetros registrados:\",\n",
        "      (datos[\"Carga_Semanal_Km\"] > 0).sum())\n",
        "print(\"Días con calorías de fuerza registradas:\",\n",
        "      (datos[\"Kcal_Fuerza\"] > 0).sum())\n",
        "\n",
        "print(\"\\nPrimeras filas de los datos preparados:\")\n",
        "print(datos[[\n",
        "    \"Fecha_DT\",\n",
        "    \"Peso(Kg)\",\n",
        "    \"Dias_Transcurridos\",\n",
        "    \"Carga_Semanal_Km\",\n",
        "    \"Kcal_Fuerza\"\n",
        "]].head(10).to_string(index=False))\n"
