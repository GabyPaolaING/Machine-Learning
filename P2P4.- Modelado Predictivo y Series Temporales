        "\n",
        "# =====================================================\n",
        "# BLOQUE 3: ESTANDARIZACIÓN Z-SCORE\n",
        "# =====================================================\n",
        "\n",
        "# Variables biométricas y de actividad que se estandarizarán\n",
        "columnas_z = [\n",
        "    'Peso(Kg)',\n",
        "    'Porcentaje de Grasa Corporal',\n",
        "    'Agua(%)',\n",
        "    'Musculos(%)',\n",
        "    'conteo_pasos',\n",
        "    'tiempo_actividad_min',\n",
        "    'calorias_kcal'\n",
        "]\n",
        "\n",
        "# Incorporar los datos de actividad según Fecha_DT\n",
        "# para conservar las columnas de pasos y minutos.\n",
        "if 'conteo_pasos' not in df_base.columns:\n",
        "    df_base = df_base.merge(\n",
        "        df_actividad[\n",
        "            ['Fecha_DT', 'conteo_pasos', 'tiempo_actividad_min']\n",
        "        ],\n",
        "        on='Fecha_DT',\n",
        "        how='left'\n",
        "    )\n",
        "\n",
        "# Incorporar calorías si no se encuentran en el DataFrame.\n",
        "# Puede haber más de una sesión por fecha; sumamos las calorías.\n",
        "if 'calorias_kcal' not in df_base.columns:\n",
        "    calorias_fecha = df_entrenamiento.groupby(\n",
        "        df_entrenamiento['Fecha_DT'].dt.normalize()\n",
        "    )['calorias_kcal'].sum()\n",
        "\n",
        "    df_base['calorias_kcal'] = (\n",
        "        df_base['Fecha_DT'].dt.normalize()\n",
        "        .map(calorias_fecha)\n",
        "    )\n",
        "\n",
        "# Convertir las variables a números y tratar faltantes.\n",
        "for columna in columnas_z:\n",
        "    if columna in df_base.columns:\n",
        "        df_base[columna] = pd.to_numeric(\n",
        "            df_base[columna], errors='coerce'\n",
        "        )\n",
        "\n",
        "# Los faltantes de pasos y tiempo de actividad representan\n",
        "# ausencia de registro de actividad, según las instrucciones previas.\n",
        "for columna in ['conteo_pasos', 'tiempo_actividad_min']:\n",
        "    if columna in df_base.columns:\n",
        "        df_base[columna] = df_base[columna].fillna(0)\n",
        "\n",
        "# Estandarizar con media y desviación estándar muestral.\n",
        "# Las columnas constantes no se pueden estandarizar: se asigna 0.\n",
        "for columna in columnas_z:\n",
        "    if columna in df_base.columns:\n",
        "        media = df_base[columna].mean()\n",
        "        desviacion = df_base[columna].std(ddof=1)\n",
        "\n",
        "        nombre_z = columna.replace('(', '_').replace(')', '').replace('%', 'pct')\n",
        "        nombre_z = nombre_z.replace(' ', '_') + '_Z'\n",
        "\n",
        "        if pd.isna(desviacion) or desviacion == 0:\n",
        "            df_base[nombre_z] = 0\n",
        "        else:\n",
        "            df_base[nombre_z] = (\n",
        "                df_base[columna] - media\n",
        "            ) / desviacion\n",
        "\n",
        "# Limpiar columnas auxiliares\n",
        "df_final = df_base.drop(\n",
        "    columns=[\n",
        "        'Cambio_peso',\n",
        "        'Dias',\n",
        "        'Peso_estimado',\n",
        "        'Residuo_peso',\n",
        "        'Residuo_peso_limpio',\n",
        "        'Fecha_DT_dia'\n",
        "    ],\n",
        "    errors='ignore'\n",
        ")\n",
        "\n",
        "# Revisar y tratar los faltantes restantes en columnas numéricas\n",
        "# y categóricas para obtener un archivo sin valores nulos.\n",
        "for columna in df_final.select_dtypes(include='number').columns:\n",
        "    df_final[columna] = df_final[columna].fillna(\n",
        "        df_final[columna].median()\n",
        "    )\n",
        "\n",
        "for columna in df_final.select_dtypes(\n",
        "    include=['object', 'string']\n",
        ").columns:\n",
        "    df_final[columna] = df_final[columna].fillna('Sin registro')\n",
        "\n",
        "# Exportar el dataset transformado\n",
        "df_final.to_csv(\n",
        "    'dataset_salud_rendimiento_transformado.csv',\n",
        "    index=False,\n",
        "    encoding='utf-8-sig'\n",
        ")\n",
        "\n",
        "print(\"Tamaño del dataset final:\", df_final.shape)\n",
        "print(\"Valores nulos restantes:\", int(df_final.isna().sum().sum()))\n",
        "display(df_final.head(10))\n"
      ],
