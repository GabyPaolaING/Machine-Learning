        "\n",
        "df_peso = df_peso.dropna(subset=[\"Fecha_DT\", \"Peso(Kg)\"])\n",
        "\n",
        "df_peso = (\n",
        "    df_peso.sort_values(\"Fecha_DT\")\n",
        "    .drop_duplicates(subset=\"Fecha_DT\", keep=\"last\")\n",
