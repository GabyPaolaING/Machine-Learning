        "\n",
        "# =====================================================\n",
        "# BLOQUE 2:\n",
        "# =====================================================\n",
        "\n",
        "# -----------------------------------------------------\n",
        "# 1. Variable binaria: fin de semana\n",
        "# -----------------------------------------------------\n",
        "\n",
        "df_base['es_fin_semana'] = (\n",
        "    df_base['Fecha_DT'].dt.dayofweek >= 5\n",
        ").astype(int)\n",
        "\n",
        "# -----------------------------------------------------\n",
        "# 2. Preparar las sesiones de entrenamiento por fecha\n",
        "# -----------------------------------------------------\n",
        "\n",
        "df_sesiones = df_entrenamiento.copy()\n",
        "\n",
        "df_sesiones['tipo_ejercicio'] = (\n",
        "    df_sesiones['tipo_ejercicio']\n",
        "    .fillna('')\n",
        "    .astype(str)\n",
        ")\n",
        "\n",
        "df_sesiones['distancia_km'] = pd.to_numeric(\n",
        "    df_sesiones['distancia_km'], errors='coerce'\n",
        ").fillna(0)\n",
        "\n",
        "df_sesiones['calorias_kcal'] = pd.to_numeric(\n",
        "    df_sesiones['calorias_kcal'], errors='coerce'\n",
        ").fillna(0)\n",
        "\n",
        "# Consideramos ciclismo las sesiones cuyo tipo incluye \"ciclismo\"\n",
        "es_ciclismo = df_sesiones['tipo_ejercicio'].str.contains(\n",
        "    'ciclismo', case=False, na=False\n",
        ")\n",
        "\n",
        "# Consideramos fuerza las sesiones de pesas o fuerza\n",
        "es_fuerza = df_sesiones['tipo_ejercicio'].str.contains(\n",
        "    'mancuernas|fuerza|pesas', case=False, na=False\n",
        ")\n",
        "\n",
        "df_sesiones['km_ciclismo'] = np.where(\n",
        "    es_ciclismo, df_sesiones['distancia_km'], 0\n",
        ")\n",
        "\n",
        "df_sesiones['calorias_fuerza'] = np.where(\n",
        "    es_fuerza, df_sesiones['calorias_kcal'], 0\n",
        ")\n",
        "\n",
        "# Agrupar sesiones de un mismo día\n",
        "df_diario = df_sesiones.groupby(\n",
        "    df_sesiones['Fecha_DT'].dt.normalize()\n",
        ").agg(\n",
        "    km_ciclismo=('km_ciclismo', 'sum'),\n",
        "    calorias_fuerza=('calorias_fuerza', 'sum')\n",
        ")\n",
        "\n",
        "# Crear calendario diario para no saltarnos días sin entrenamientos\n",
        "calendario = pd.date_range(\n",
        "    start=min(df_base['Fecha_DT'].min(), df_diario.index.min()),\n",
        "    end=max(df_base['Fecha_DT'].max(), df_diario.index.max()),\n",
        "    freq='D'\n",
        ")\n",
        "\n",
        "df_diario = df_diario.reindex(calendario, fill_value=0)\n",
        "df_diario.index.name = 'Fecha_DT'\n",
        "\n",
        "# -----------------------------------------------------\n",
        "# 3. Carga semanal de ciclismo: suma móvil de 7 días\n",
        "# -----------------------------------------------------\n",
        "\n",
        "df_diario['carga_semanal_km'] = (\n",
        "    df_diario['km_ciclismo']\n",
        "    .rolling(window=7, min_periods=1)\n",
        "    .sum()\n",
        ")\n",
        "\n",
        "# -----------------------------------------------------\n",
        "# 4. Ratio fuerza/cardio\n",
        "# -----------------------------------------------------\n",
        "# Definición: calorías de fuerza de los últimos 7 días\n",
        "# divididas entre kilómetros de ciclismo de los últimos 7 días.\n",
        "\n",
        "df_diario['calorias_fuerza_7d'] = (\n",
        "    df_diario['calorias_fuerza']\n",
        "    .rolling(window=7, min_periods=1)\n",
        "    .sum()\n",
        ")\n",
        "\n",
        "df_diario['ratio_fuerza_cardio'] = np.where(\n",
        "    df_diario['carga_semanal_km'] > 0,\n",
        "    df_diario['calorias_fuerza_7d']\n",
        "    / df_diario['carga_semanal_km'],\n",
        "    0\n",
        ")\n",
        "\n",
        "# Incorporar variables calculadas al dataset de pesajes\n",
        "df_base['Fecha_DT_dia'] = df_base['Fecha_DT'].dt.normalize()\n",
        "\n",
        "df_base = df_base.merge(\n",
        "    df_diario[\n",
        "        [\n",
        "            'carga_semanal_km',\n",
        "            'ratio_fuerza_cardio'\n",
        "        ]\n",
        "    ],\n",
        "    left_on='Fecha_DT_dia',\n",
        "    right_index=True,\n",
        "    how='left'\n",
        ")\n",
        "\n",
        "# -----------------------------------------------------\n",
        "# 5. Distancia al normopeso\n",
        "# -----------------------------------------------------\n",
        "\n",
        "peso_objetivo = 70.28\n",
        "\n",
        "df_base['distancia_al_normopeso'] = (\n",
        "    df_base['Peso(Kg)'] - peso_objetivo\n",
        ")\n",
        "\n",
        "# Un valor positivo indica kg por encima de la meta.\n",
        "# Un valor negativo indica kg por debajo de la meta.\n",
        "\n",
        "print(\"Variables sintéticas creadas:\")\n",
        "display(\n",
        "    df_base[\n",
        "        [\n",
        "            'Fecha_DT',\n",
        "            'es_fin_semana',\n",
        "            'carga_semanal_km',\n",
        "            'ratio_fuerza_cardio',\n",
        "            'distancia_al_normopeso'\n",
        "        ]\n",
        "    ].head(10)\n",
        ")\n"
      ],
